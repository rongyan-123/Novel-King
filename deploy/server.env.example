# 复制为项目根目录 .env，填写实际域名和首次管理员密码。不要提交 .env。
NOVELKING_DOMAIN=novel.example.com
NOVELKING_PUBLIC_ORIGIN=https://novel.example.com
NOVELKING_ADMIN_USER=owner
NOVELKING_ADMIN_PASSWORD=replace-with-your-own-long-password
NOVELKING_MAX_WORKERS=4
NOVELKING_AI_ORIGINS=https://api.deepseek.com,https://api.openai.com
NOVELKING_REGISTRATION=open
# 使用仅含字母、数字和下划线的随机长密码（URL 中无需转义）。
NOVELKING_POSTGRES_PASSWORD=replace_with_random_database_password
NOVELKING_RANK_READER_TOKEN=replace_with_random_service_token
NOVELKING_MCP_ORIGINS=https://mcp.exa.ai,https://mcp.tavily.com
# 默认本机应用端口 3741。网段冲突时同时填写以下三项。
# NOVELKING_PORT=3741
# NOVELKING_NETWORK_SUBNET=192.168.80.0/24
# NOVELKING_APP_IP=192.168.80.3
# NOVELKING_PROXY_IP=192.168.80.2
